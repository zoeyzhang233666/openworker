{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemclaw.followup-plan.v1",
  "title": "FollowupPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "lead_or_opportunity_id",
    "steps",
    "stop_conditions",
    "human_checkpoints"
  ],
  "properties": {
    "schema_version": {"const": "chemclaw.followup-plan.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "lead_or_opportunity_id": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day_offset", "purpose", "draft_outline"],
        "properties": {
          "day_offset": {"type": "integer", "minimum": 0},
          "purpose": {"type": "string", "minLength": 1},
          "draft_outline": {"type": "string", "minLength": 1}
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "human_checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
