{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemclaw.commercial-sku.v1",
  "title": "CommercialSKU",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sku_id",
    "identity_status",
    "names",
    "cas",
    "identity_evidence_ids",
    "specification",
    "target_uses",
    "excluded_uses",
    "regulatory_status",
    "conflicts"
  ],
  "properties": {
    "schema_version": {"const": "chemclaw.commercial-sku.v1"},
    "sku_id": {"type": "string", "minLength": 1},
    "identity_status": {"enum": ["resolved", "unresolved", "conflicted"]},
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "aliases"],
      "properties": {
        "standard": {"type": ["string", "null"], "minLength": 1},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidencedTerm"}
        }
      }
    },
    "cas": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^[0-9]{2,7}-[0-9]{2}-[0-9]$"
    },
    "identity_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "purity", "packaging", "delivery_form"],
      "properties": {
        "grade": {"type": ["string", "null"], "minLength": 1},
        "purity": {"type": ["string", "null"], "minLength": 1},
        "packaging": {"type": ["string", "null"], "minLength": 1},
        "delivery_form": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "target_uses": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidencedUse"}
    },
    "excluded_uses": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidencedUse"}
    },
    "regulatory_status": {
      "type": "array",
      "items": {"$ref": "#/$defs/regulatoryRecord"}
    },
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"identity_status": {"const": "resolved"}}},
      "then": {
        "properties": {
          "names": {
            "properties": {"standard": {"type": "string", "minLength": 1}}
          }
        },
        "anyOf": [
          {"properties": {"cas": {"type": "string", "minLength": 1}}},
          {"properties": {"identity_evidence_ids": {"minItems": 1}}}
        ]
      }
    },
    {
      "if": {"properties": {"identity_status": {"const": "conflicted"}}},
      "then": {"properties": {"conflicts": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "evidencedTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "language", "evidence_ids"],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidencedUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidence_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "regulatoryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market", "status", "evidence_ids"],
      "properties": {
        "market": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "values", "source_ids"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "values": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
