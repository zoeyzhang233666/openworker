{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemclaw.outreach-gate.output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_set", "draft_id", "verdict", "violations", "recommended_action"],
  "properties": {
    "schema_version": {"const": "chemclaw.outreach-gate.output.v1"},
    "rule_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "chem-sales-quality"},
        "version": {"const": "1.0.0"}
      }
    },
    "draft_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["pass", "blocked"]},
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "recommended_action": {
      "enum": [
        "ready_for_human_send",
        "ready_for_crm_write",
        "ready_for_crm_create_contact",
        "revise_draft"
      ]
    }
  }
}
