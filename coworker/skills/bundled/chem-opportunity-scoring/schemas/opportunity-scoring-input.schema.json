{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemclaw.opportunity-scoring.input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "rule_set", "opportunity", "signals"],
  "properties": {
    "schema_version": {"const": "chemclaw.opportunity-scoring.input.v1"},
    "as_of": {"type": "string", "format": "date"},
    "rule_set": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "weights"],
      "properties": {
        "id": {"const": "chem-opportunity-fit"}, "version": {"const": "1.0.0"},
        "weights": {
          "type": "object", "additionalProperties": false,
          "required": ["signal_recency", "entity", "sku_relevance", "urgency", "actionability"],
          "properties": {
            "signal_recency": {"const": 25}, "entity": {"const": 20}, "sku_relevance": {"const": 25},
            "urgency": {"const": 15}, "actionability": {"const": 15}
          }
        }
      }
    },
    "opportunity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "entity_resolution", "sku_relevance", "features"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["Watch", "NeedsReview", "Actionable", "Rejected"]},
        "entity_resolution": {"enum": ["resolved", "partial", "unresolved"]},
        "sku_relevance": {"enum": ["pending", "related", "unrelated", "unknown"]},
        "features": {
          "type": "object", "additionalProperties": false,
          "required": ["signal_recency", "entity", "sku_relevance", "urgency", "actionability"],
          "properties": {
            "signal_recency": {"$ref": "#/$defs/feature"},
            "entity": {"$ref": "#/$defs/feature"},
            "sku_relevance": {"$ref": "#/$defs/feature"},
            "urgency": {"$ref": "#/$defs/feature"},
            "actionability": {"$ref": "#/$defs/feature"}
          }
        }
      }
    },
    "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}}
  },
  "$defs": {
    "feature": {
      "type": "object", "additionalProperties": false, "required": ["signal_ids"],
      "properties": {"signal_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["type", "url", "file", "record_id"],
      "properties": {
        "type": {"enum": ["official_website", "government_registry", "trade_record", "industry_directory", "public_procurement", "b2b_directory", "search_result", "user_file", "other"]},
        "url": {"$ref": "#/$defs/realLocator"},
        "file": {"$ref": "#/$defs/realLocator"},
        "record_id": {"$ref": "#/$defs/realLocator"}
      },
      "anyOf": [{"properties": {"url": {"type": "string", "minLength": 1}}}, {"properties": {"file": {"type": "string", "minLength": 1}}}, {"properties": {"record_id": {"type": "string", "minLength": 1}}}]
    },
    "realLocator": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "not": {"pattern": "(?i)^(task-provided|unknown|placeholder):"}}
      ]
    },
    "signal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "signal_type", "summary", "source", "title", "raw_fact", "supports", "polarity", "tier", "independence_group", "event_date", "collected_at", "conflict"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "signal_type": {"enum": ["inquiry", "tender", "trade", "capacity", "hiring", "price", "exhibition", "other"]},
        "summary": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "title": {"type": "string", "minLength": 1},
        "raw_fact": {"type": "string", "minLength": 1},
        "supports": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["signal_recency", "entity", "sku_relevance", "urgency", "actionability"]}
        },
        "polarity": {"enum": ["supports", "contradicts"]},
        "tier": {"enum": ["A", "B", "C", "D"]},
        "independence_group": {"type": "string", "minLength": 1},
        "event_date": {"type": ["string", "null"], "format": "date"},
        "collected_at": {"type": "string", "format": "date-time"},
        "conflict": {"enum": ["none", "unresolved", "material"]}
      }
    }
  }
}
