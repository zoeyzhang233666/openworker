{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemclaw.quote-run.v1",
  "title": "QuoteRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "updated_at",
    "status",
    "inquiry_id",
    "draft_ids",
    "calculator_version",
    "missing_fields",
    "warnings",
    "next_actions"
  ],
  "properties": {
    "schema_version": {"const": "chemclaw.quote-run.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1, "format": "date-time"},
    "updated_at": {"type": "string", "minLength": 1, "format": "date-time"},
    "status": {
      "enum": ["input", "parse", "calculate", "draft", "complete", "blocked"]
    },
    "inquiry_id": {"type": "string", "minLength": 1},
    "draft_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "calculator_version": {"type": ["string", "null"], "minLength": 1},
    "missing_fields": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "next_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
