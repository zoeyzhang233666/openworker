{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemclaw.prospecting-run.v1",
  "title": "ProspectingRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "updated_at",
    "status",
    "input",
    "versions",
    "providers",
    "stages",
    "candidate_ids",
    "qualified_lead_ids",
    "needs_review_ids",
    "rejected_ids",
    "budget",
    "warnings",
    "unresolved_questions",
    "next_actions"
  ],
  "properties": {
    "schema_version": {"const": "chemclaw.prospecting-run.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1, "format": "date-time"},
    "updated_at": {"type": "string", "minLength": 1, "format": "date-time"},
    "status": {"enum": ["input", "product_ready", "discovery", "qualification", "ranking", "complete", "blocked"]},
    "input": {"$ref": "#/$defs/input"},
    "versions": {"$ref": "#/$defs/versions"},
    "providers": {
      "type": "array",
      "items": {"$ref": "#/$defs/provider"}
    },
    "stages": {
      "type": "array",
      "items": {"$ref": "#/$defs/stage"}
    },
    "candidate_ids": {"$ref": "#/$defs/idList"},
    "qualified_lead_ids": {"$ref": "#/$defs/idList"},
    "needs_review_ids": {"$ref": "#/$defs/idList"},
    "rejected_ids": {"$ref": "#/$defs/idList"},
    "budget": {"$ref": "#/$defs/budget"},
    "warnings": {"$ref": "#/$defs/textList"},
    "unresolved_questions": {"$ref": "#/$defs/textList"},
    "next_actions": {"$ref": "#/$defs/textList"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}},
      "then": {"properties": {"stages": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {
        "properties": {
          "stages": {
            "contains": {"properties": {"status": {"const": "blocked"}}}
          }
        }
      }
    }
  ],
  "$defs": {
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "textList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku_id", "request_summary", "requested_lead_count", "target_markets"],
      "properties": {
        "sku_id": {"type": "string", "minLength": 1},
        "request_summary": {"type": "string", "minLength": 1},
        "requested_lead_count": {"type": "integer", "minimum": 1},
        "target_markets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/targetMarket"}
        }
      }
    },
    "targetMarket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "regions", "languages", "customer_types", "exclusions", "compliance_constraints"],
      "properties": {
        "country": {"type": "string", "minLength": 1},
        "regions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "customer_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "compliance_constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator_version", "skill_versions", "rule_versions"],
      "properties": {
        "orchestrator_version": {"type": "string", "minLength": 1},
        "skill_versions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/versionRecord"}
        },
        "rule_versions": {
          "type": "array",
          "items": {"$ref": "#/$defs/ruleVersion"}
        }
      }
    },
    "versionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "version"],
      "properties": {
        "skill_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "ruleVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "version"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "version", "status", "calls_made", "failure"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["available", "degraded", "unavailable"]},
        "calls_made": {"type": "integer", "minimum": 0},
        "failure": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "name",
        "status",
        "skill_id",
        "skill_version",
        "rule_version",
        "started_at",
        "updated_at",
        "completed_at",
        "input_ids",
        "output_ids",
        "query_ids",
        "evidence_ids",
        "failure",
        "checkpoint"
      ],
      "properties": {
        "stage_id": {"type": "string", "minLength": 1},
        "name": {"enum": ["input", "product_ready", "discovery", "qualification", "ranking", "complete"]},
        "status": {"enum": ["pending", "running", "complete", "partial", "blocked", "skipped"]},
        "skill_id": {"type": "string", "minLength": 1},
        "skill_version": {"type": "string", "minLength": 1},
        "rule_version": {"type": ["string", "null"], "minLength": 1},
        "started_at": {"type": ["string", "null"], "minLength": 1, "format": "date-time"},
        "updated_at": {"type": "string", "minLength": 1, "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "minLength": 1, "format": "date-time"},
        "input_ids": {"$ref": "#/$defs/idList"},
        "output_ids": {"$ref": "#/$defs/idList"},
        "query_ids": {"$ref": "#/$defs/idList"},
        "evidence_ids": {"$ref": "#/$defs/idList"},
        "failure": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/failure"}
          ]
        },
        "checkpoint": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/checkpoint"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "blocked"}}},
          "then": {"properties": {"failure": {"$ref": "#/$defs/failure"}}}
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "saved_at"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "saved_at": {"type": "string", "minLength": 1, "format": "date-time"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_limit", "query_used", "paid_call_limit", "paid_call_used"],
      "properties": {
        "query_limit": {"type": "integer", "minimum": 0},
        "query_used": {"type": "integer", "minimum": 0},
        "paid_call_limit": {"type": "integer", "minimum": 0},
        "paid_call_used": {"type": "integer", "minimum": 0}
      }
    }
  }
}
